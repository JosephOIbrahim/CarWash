#usda 1.0
(
    """
    CarWash Render Settings API Schema

    This schema defines the CarWashRenderSettingsAPI which appears as a tab
    in Houdini's Render Settings LOP UI when the CarWash renderer is selected.

    Reference: Karma's usdKarma/KarmaRenderSettingsAPI pattern
    """
    subLayers = [
        @usd/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "usdCarWash"
        string libraryPath = "."
        dictionary libraryTokens = {
            dictionary carwash = {
                string doc = "CarWash attribute namespace"
            }
        }
    }
) {
}

class "CarWashRenderSettingsAPI" (
    inherits = </APISchemaBase>
    customData = {
        string className = "CarWashRenderSettingsAPI"
        token apiSchemaType = "singleApply"
        token[] apiSchemaCanOnlyApplyTo = ["RenderSettings"]
        string extraIncludes = """
#include "pxr/imaging/hd/renderDelegate.h"
"""
    }
    doc = """CarWash AI renderer settings API schema.

    This API schema provides settings for the CarWash Hydra render delegate,
    which uses AI-based image generation with depth and normal conditioning.

    The schema enables the CarWash tab to appear in Houdini's Render Settings LOP.
    """
) {
    # ========================================
    # AI Generation Settings
    # ========================================

    string carwash:prompt = "photorealistic 3D render, high quality, detailed" (
        displayGroup = "AI Generation"
        displayName = "Prompt"
        doc = """The text prompt that guides AI image generation.
        This prompt is combined with scene context for consistent results."""
    )

    string carwash:negativePrompt = "blurry, low quality, artifacts" (
        displayGroup = "AI Generation"
        displayName = "Negative Prompt"
        doc = "Text describing what to avoid in the generated image."
    )

    int carwash:seed = 42 (
        displayGroup = "AI Generation"
        displayName = "Seed"
        doc = """Random seed for deterministic generation.
        Same seed + same inputs = same output (batch-invariant)."""
    )

    int carwash:steps = 20 (
        displayGroup = "AI Generation"
        displayName = "Steps"
        doc = "Number of diffusion steps. More steps = higher quality, longer time."
    )

    float carwash:cfg = 7.0 (
        displayGroup = "AI Generation"
        displayName = "CFG Scale"
        doc = "Classifier-free guidance scale. Higher = more prompt adherence."
    )

    float carwash:denoise = 1.0 (
        displayGroup = "AI Generation"
        displayName = "Denoise Strength"
        doc = "Denoising strength (0-1). Lower preserves more of the input."
    )

    # ========================================
    # Conditioning Settings
    # ========================================

    bool carwash:useDepth = true (
        displayGroup = "Conditioning"
        displayName = "Use Depth"
        doc = "Enable depth-conditioned generation from rendered depth pass."
    )

    float carwash:depthStrength = 0.8 (
        displayGroup = "Conditioning"
        displayName = "Depth Strength"
        doc = "How strongly depth conditioning influences the output (0-1)."
    )

    bool carwash:useNormal = true (
        displayGroup = "Conditioning"
        displayName = "Use Normals"
        doc = "Enable normal-conditioned generation from rendered normal pass."
    )

    float carwash:normalStrength = 0.6 (
        displayGroup = "Conditioning"
        displayName = "Normal Strength"
        doc = "How strongly normal conditioning influences the output (0-1)."
    )

    bool carwash:useBeauty = false (
        displayGroup = "Conditioning"
        displayName = "Use Beauty Pass"
        doc = "Use the beauty pass as additional conditioning (img2img style)."
    )

    float carwash:beautyStrength = 0.3 (
        displayGroup = "Conditioning"
        displayName = "Beauty Strength"
        doc = "Strength of beauty pass influence when enabled."
    )

    # ========================================
    # Style Memory Settings
    # ========================================

    bool carwash:useStyleMemory = true (
        displayGroup = "Style Memory"
        displayName = "Enable Style Memory"
        doc = "Maintain style consistency across frames using cognitive substrate."
    )

    string carwash:styleId = "default" (
        displayGroup = "Style Memory"
        displayName = "Style ID"
        doc = "Identifier for style memory cache. Same ID shares style across shots."
    )

    float carwash:styleStrength = 1.0 (
        displayGroup = "Style Memory"
        displayName = "Style Strength"
        doc = "How strongly to apply cached style (0-2)."
    )

    # ========================================
    # Temporal Coherence Settings
    # ========================================

    bool carwash:temporalBlend = true (
        displayGroup = "Temporal"
        displayName = "Temporal Blending"
        doc = "Blend with previous frames for animation coherence."
    )

    float carwash:temporalStrength = 0.3 (
        displayGroup = "Temporal"
        displayName = "Temporal Strength"
        doc = "Blend strength with previous frame (0-1)."
    )

    bool carwash:useMotionVectors = false (
        displayGroup = "Temporal"
        displayName = "Use Motion Vectors"
        doc = "Use motion vectors for motion-compensated temporal blending."
    )

    # ========================================
    # Determinism Settings
    # ========================================

    bool carwash:strictDeterminism = true (
        displayGroup = "Determinism"
        displayName = "Strict Determinism"
        doc = """Enable strict batch-invariant mode.
        Requires batch_invariant_ops for full determinism."""
    )

    bool carwash:verifyOutput = false (
        displayGroup = "Determinism"
        displayName = "Verify Output"
        doc = "Compute and log output hash for determinism verification."
    )

    # ========================================
    # ComfyUI Backend Settings
    # ========================================

    string carwash:comfyHost = "localhost" (
        displayGroup = "Backend"
        displayName = "ComfyUI Host"
        doc = "Hostname of the ComfyUI server."
    )

    int carwash:comfyPort = 8188 (
        displayGroup = "Backend"
        displayName = "ComfyUI Port"
        doc = "Port of the ComfyUI server."
    )

    string carwash:workflowPath = "" (
        displayGroup = "Backend"
        displayName = "Workflow Path"
        doc = "Optional path to custom ComfyUI workflow JSON."
    )

    int carwash:timeout = 120 (
        displayGroup = "Backend"
        displayName = "Timeout (seconds)"
        doc = "Maximum time to wait for ComfyUI response."
    )
}
